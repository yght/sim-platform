# Auth0 - no real values here, fill in your own tenant
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.simplatform.io
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/

# Carrier endpoints. These point at the local stub server in docker-compose,
# not at real carriers.
BELL_BASE_URL=http://carrier-stub:4010/bell
BELL_CLIENT_ID=stub
BELL_CLIENT_SECRET=stub

VODAFONE_BASE_URL=http://carrier-stub:4010/vodafone
VODAFONE_API_KEY=stub
VODAFONE_CALLBACK_URL=http://carrier-service:3002/callbacks/vodafone

ATT_BASE_URL=http://carrier-stub:4010/att
ATT_CLIENT_ID=stub
ATT_CLIENT_SECRET=stub

# Infrastructure
MONGO_URL=mongodb://mongo:27017/simplatform
RABBIT_URL=amqp://rabbitmq:5672
LOG_LEVEL=info
