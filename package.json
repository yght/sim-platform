{
  "name": "sim-platform",
  "version": "1.4.0",
  "private": true,
  "description": "Multi-carrier SIM lifecycle management platform",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/services/**/*.test.js",
      "<rootDir>/packages/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/src/**/*.js",
      "packages/**/src/**/*.js"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=8.11.0"
  }
}
