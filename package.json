{
  "name": "sim-platform",
  "version": "1.4.0",
  "private": true,
  "description": "Multi-carrier SIM lifecycle management platform",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:outbox": "node --test modern/outbox/outbox.test.mjs",
    "demo:outbox": "node modern/outbox/demo.mjs",
    "test:ci": "npm test -- --runInBand && npm run test:outbox"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/services/**/*.test.js",
      "<rootDir>/packages/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/src/**/*.js",
      "packages/**/src/**/*.js"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
